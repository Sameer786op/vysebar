{
  "name": "vysebar",
  "productName": "VyseBar",
  "version": "0.7.6",
  "private": true,
  "description": "VyseBar: a smart dock for Windows 11 with live widgets. Replaces the taskbar.",
  "license": "MIT",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "host": "node scripts/build-host.mjs",
    "dev": "node scripts/build-host.mjs && electron-vite dev",
    "build": "node scripts/build-host.mjs && electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "icons": "electron scripts/make-icons.mjs",
    "dist:win": "npm run build && electron-builder --win --x64 --publish never",
    "dist:win32": "npm run build && electron-builder --win --ia32 -c.electronVersion=43.8.7 -c.publish.channel=ia32 --publish never",
    "dist:all": "npm run dist:win && electron-builder --win --ia32 -c.electronVersion=43.8.7 -c.publish.channel=ia32 --publish never"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.9.3",
    "electron-builder": "^26.18.0",
    "electron-updater": "^6.8.11",
    "electron-vite": "^5.0.0",
    "lucide-react": "^1.61.0",
    "motion": "^12.43.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "zustand": "^5.0.16"
  },
  "author": "Sameer"
}
